# ==============================================================================
# AgrooNext — Agro-Tech & Training Environment Variables Template
# ==============================================================================

# Database Configuration
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/agroonext_db?schema=public"

# Authentication & Session Security (Required: minimum 32 random characters in production)
JWT_SECRET="replace_with_secure_random_jwt_secret_in_production"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Online Payment Gateway (Razorpay) — Leave blank for Mock/Development mode (DEC-015)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Transactional Email (SMTP) — Leave blank for console simulation mode
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AgrooNext Admissions <admissions@agroonext.org>"

# Document Storage (Local private upload directory; configure S3/R2 keys for cloud storage)
UPLOAD_DIR="./private_uploads"
